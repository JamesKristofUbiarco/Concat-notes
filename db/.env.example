# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (DOCKER / POSTGRESQL)
# ============================================================================

# Nombre de la base de datos
POSTGRES_DB=notes_db

# Usuario administrador de la base de datos
POSTGRES_USER=notes_user

# Contraseña del usuario administrador (Cambiar en producción)
POSTGRES_PASSWORD=notes_password

# Puerto expuesto en el host local
POSTGRES_PORT=5432

# URL de conexión de la base de datos (Útil para backend de FastAPI / SQLAlchemy)
DATABASE_URL=postgresql://notes_user:notes_password@localhost:5432/notes_db
