# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS E INFRAESTRUCTURA (FastAPI + Docker)
# ==============================================================================

# URL de conexión de la base de datos PostgreSQL local levantada en Docker (db/)
DATABASE_URL=postgresql://notes_user:notes_password@localhost:5432/notes_db

# Puerto en el que correrá el servidor de FastAPI
PORT=8000


# ==============================================================================
# CONFIGURACIÓN DEL AGENTE INTELIGENTE (LangGraph + Gemini + VoyageAI)
# ==============================================================================

# 1. API Key de Google Gemini nativa (Opcional si usas OpenRouter)
# Obtén tu llave en: https://aistudio.google.com/
GOOGLE_API_KEY=

# 1.1 API Key de OpenRouter (Prioritaria)
# Requerida si deseas rutear las llamadas a través de OpenRouter con Google AI Studio.
# Obtén tu llave en: https://openrouter.ai/
OPENROUTER_API_KEY=

# 2. Modelos de Gemini a utilizar por el agente.
# Valores recomendados de la versión 3.5 (Julio de 2026):
# - google/gemini-3.6-flash (Modelo rápido y económico por defecto)
# - google/gemini-3.5-pro   (Modelo de razonamiento profundo y alta precisión cognitiva)
GEMINI_MODEL=google/gemini-3.6-flash
GEMINI_LITE_MODEL=google/gemini-3.1-flash-lite

# 3. API Key de VoyageAI (Opcional)
# Requerida para generar embeddings vectoriales reales de Voyage-4 en pgvector.
# Si se deja vacío, el agente utilizará un fallback de keyword-lookup automático.
VOYAGE_API_KEY=


# ==============================================================================
# OBSERVABILIDAD OPCIONAL (LangSmith Trace Tracking)
# ==============================================================================
# Si deseas visualizar la ejecución del grafo de LangGraph en tiempo real:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=nextjs-notes-langgraph-agent

# ==============================================================================
# CONFIGURACIÓN DE ALMACENAMIENTO DE OBJETOS (RustFS / S3)
# ==============================================================================
# Endpoint de la API de S3 interno (para el backend) y externo (para el navegador)
RUSTFS_ENDPOINT_INTERNAL=http://rustfs:9000
RUSTFS_ENDPOINT_EXTERNAL=http://localhost:9000

# Credenciales de acceso a RustFS
RUSTFS_ACCESS_KEY=rustfs_admin
RUSTFS_SECRET_KEY=rustfs_password

# Nombre del bucket público para las imágenes
RUSTFS_BUCKET_NAME=notes-images
